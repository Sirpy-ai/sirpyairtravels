{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.sirpyairtravels.com" }],
      "destination": "https://sirpyairtravels.com/:path*",
      "permanent": true
    },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/packages", "destination": "/tours", "permanent": true },
    { "source": "/blog", "destination": "/offers", "permanent": true },
    { "source": "/news", "destination": "/offers", "permanent": true },
    { "source": "/article", "destination": "/travel-tips", "permanent": true },
    { "source": "/search", "destination": "/flights", "permanent": true }
  ]
}
